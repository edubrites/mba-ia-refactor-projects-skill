# Copie para .env (ou exporte no shell) — nunca commite valores reais.
APP_ENV=development          # production exige SECRET_KEY definida
SECRET_KEY=
DEBUG=false
HOST=0.0.0.0
PORT=5000
DATABASE_URL=sqlite:///tasks.db
TOKEN_MAX_AGE=86400          # validade do token de login, em segundos
EMAIL_ENABLED=false          # true exige SMTP_HOST, SMTP_USER e SMTP_PASSWORD
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
