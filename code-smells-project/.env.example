# Copie para .env (ou exporte no shell) — nunca commite valores reais.
APP_ENV=development          # production exige SECRET_KEY definida
SECRET_KEY=
DEBUG=false
HOST=0.0.0.0
PORT=5000
DB_PATH=loja.db
SEED_USER_PASSWORD=          # senha dos usuários de exemplo; vazio = gerada e exibida no log
ADMIN_RESET_ENABLED=false    # true registra POST /admin/reset-db (exige ADMIN_TOKEN)
ADMIN_TOKEN=
